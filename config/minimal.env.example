# DEBUGGING BASELINE, not the production config. TensorFold GLM-5.3-Flash on 2x DGX Spark with few patches active:
# 32,768 tokens a request, one request at a time, the upstream per-head KV cache. Use it to check whether a problem
# also happens without the production knobs. For normal use, run config/prod.env (from config/prod.env.example,
# serve.sh's default): 1,048,576 tokens, 4 requests (README Quickstart, AGENTS.md).
# To use this baseline: cp config/minimal.env.example config/minimal.env, fill in the nodes / link / weights keys, then
#   CONFIG=config/minimal.env scripts/serve.sh start
# Read by scripts/serve.sh (sourced) and by docker/compose.yaml (docker compose --env-file); for podman add the
# override file: podman compose --env-file config/minimal.env -f docker/compose.yaml -f docker/compose.podman.yaml.

# --- nodes / link ---------------------------------------------------------------
# ssh target of the worker Spark (rank 1); serve.sh runs the container runtime there over ssh
# e.g. user@<worker CX7 address>
WORKER_SSH="<worker-ssh>"
# rank 0's address on the CX7 link
# e.g. the head's address on the CX7 subnet
HEAD_IP="<head-ip>"
# CX7 netdev and RDMA device on the link: `ibdev2netdev` prints "<RDMA device> port 1 ==> <netdev> (Up)" for the
# cabled port; `ip -br addr show <netdev>` shows its address. These are the usual names on a DGX Spark
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
MASTER_PORT=29551

# --- weights (each node's HF cache is mounted at /root/.cache/huggingface) -------
# absolute host paths, e.g. /home/<you>/.cache/huggingface
HEAD_HF="<head HF cache>"
WORKER_HF="<worker HF cache>"
# patches/0140: prepared rank folders (scripts/prepare.sh; ~83 GB a key a rank); default <HF cache>/../glm53-tf/prepared
# HEAD_PREPARED=
# WORKER_PREPARED=
# patches/0250: the session store's NVMe tier, mounted at /sessions; default <HF cache>/../glm53-tf/sessions
# HEAD_SESSIONS=
# WORKER_SESSIONS=
# neko-legends abliterated EXL3: 4-bit mcg routed experts, BF16 elsewhere, MTP layer included.
# Path inside the container; the snapshot must exist in both nodes' caches.
MODEL_PATH=/root/.cache/huggingface/hub/models--neko-legends--GLM-5.3-Flash-Uncensored-EXL3/snapshots/07135ec082f8f11f7a71e4244a4e5167a0f96277
# Optional DFlash2 drafter (CC BY-NC-ND 4.0: non-commercial use only; download it yourself).
# Leave empty to let TensorFold decide (MTP only if the drafter is absent).
DRAFTER=/root/.cache/huggingface/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/7d74cdd881ed7e32c31175984a67823127b66cfe

# --- serving --------------------------------------------------------------------
IMAGE=glm53-tensorfold:dev
# same port and model name as the production config, so a client works against either
SERVED_NAME=GLM-5.3-Flash-EXL3
# 127.0.0.1 keeps the API local to the head node; 0.0.0.0 exposes it (there is no auth)
HOST=127.0.0.1
PORT=8000
# prompt + reply tokens per request (max_tokens counts: it is reserved up front); upstream rejects prompts past 2051
# tokens unless this is set. The per-head KV cache of this baseline (GLM53_TF_LATENT_KV unset) takes ~0.4 MB a token a
# rank: 32768 is verified, ~100k is the most that fits next to the weights (serve.sh refuses past 131072). Longer
# contexts need GLM53_TF_LATENT_KV=1 + GLM53_TF_KV_DTYPE=fp8 (7.4 KB a token): use config/prod.env.example.
CONTEXT=32768
# MTP_DRAFTS=
# NO_DRAFTS=1
# EXTRA_ARGS=
# EXL3 non-expert weights: bf16 (upstream) | q4 | q4mse (patches/0001). q4mse is what the results use.
GLM53_TF_NONEXPERT=q4mse
# rows a prefill chunk commits at once (patches/0003; upstream 64, ~5 MB of window buffers a row), or auto
# (patches/0085: each prefill picks its chunk, the rows to prefill up to GLM53_TF_PREFILL_ROWS_MAX, default 64)
GLM53_TF_PREFILL_ROWS=auto
# most DFlash2 drafts a round of the default policy `auto` verifies (patches/0010; upstream 5, 1..7)
GLM53_TF_AUTO_FDRAFTS=7
# draft cost calibration (patches/0070): verify windows timed on the model's own continuation of a fixed text
# (real) or on upstream's random ids (random, for A/B); both ranks must match
GLM53_TF_CALIB=real
# 1: rank 0 refines the verify costs from measured rounds (EMA per window size) and sends them in each header
GLM53_TF_CALIB_ONLINE=0
# draft depth of `auto` (patches/0071): threshold (upstream c3:0.35 / fcN:0.3 and the lookup ratio gate) or cost
# (each round the depth with the most expected tokens net of the running rate x ms); per request: o, om[N], of[N]
GLM53_TF_DEPTH=threshold
# fast prefill (patches/0080): prefill chunks through kernels that need not be row-invariant. patches/0085: the state
# does not depend on the chunk size; snapshots at the prompt's last multiple of GLM53_TF_SNAPSHOT_GRID (64), resumable
# by any chunk size (a next turn re-prefills < 64 old tokens and the reply). Replies differ from 0; drafted == serial
# and resumed == fresh hold. Per request: tf_knobs.fast_prefill
GLM53_TF_FAST_PREFILL=0
# GLM53_TF_SNAPSHOT_GRID=64
# skip the snapshot cut (an extra < 64-row chunk) when the last chunk already starts within N rows of it
# GLM53_TF_SNAPSHOT_TAIL=256
# rank partials of fast chunks on the link: bf16 (half the bytes) or fp32
GLM53_TF_FAST_GATHER=bf16
# multi-session state cache (patches/0110): GiB a rank for other sessions' snapshots and attention rows (0: off,
# only the last request's state is kept). A switch back to a stored session copies it in (~5 ms at 30k tokens)
# instead of re-prefilling it; best with GLM53_TF_LATENT_KV=1 (13-19 KB a token instead of 390). Off in this minimal
# template; the prod examples use it with the latent cache (keep it <= 6 GiB at 524k context)
GLM53_TF_SESSION_GIB=0
# checkpoints ("marks") inside long prompts every N tokens (0: none), and at fork points >= N tokens past a resume
GLM53_TF_SESSION_EVERY=16384
GLM53_TF_SESSION_FORK_MIN=512
# patches/0180: with GLM53_TF_BATCH > 1, 1 puts the store behind every batch slot (restore into any free slot, saves
# from every slot; its budget is set aside next to the slots at load). 0 (default): batch slots keep only their own
# snapshots and GLM53_TF_SESSION_GIB is ignored in batch mode
# GLM53_TF_BATCH_SESSIONS=0
# patches/0250: the store's entries also on local NVMe (serve.sh mounts HEAD_/WORKER_SESSIONS at /sessions): an evicted
# session comes back in ~0.1-0.3 s (40k-100k tokens) instead of a cold prefill, and sessions survive restarts. Each
# rank writes its own shard: ~0.4 GB a rank for a 40k session (FP8 KV; shared prefixes stored once, a new turn writes
# its new pages + a ~94 MB snapshot). save: write-through (restart-safe); evict: only what the RAM store evicts
# GLM53_TF_SESSION_DISK=/sessions
# GLM53_TF_SESSION_DISK_GIB=64
# GLM53_TF_SESSION_DISK_WRITE=save
# GLM53_TF_SESSION_DISK_MIN=1024
# patches/0200 (with GLM53_TF_BATCH > 1; all off by default, same bits either way; docs/PATCHES.md 0200):
# capture a batched-round graph key on its N-th sighting (1: the first, 0120); KDA parity in the graph key instead of a
# 71 MB state copy a slot and round; every slot's MTP chain drafted in one head pass a step; cost depths price a row
# past the verify table at >= F ms; prompts of <= N tokens prefill in their admission round; pad windows to sizes
# GLM53_TF_BATCH_CAPTURE_AFTER=3
# GLM53_TF_BATCH_PARITY_KEY=1
# GLM53_TF_BATCH_MTP=1
# GLM53_TF_BATCH_ROW_MS=6.5
# GLM53_TF_BATCH_SHORT=1024
# GLM53_TF_BATCH_PAD=
# decode-step kernels (patches/0130): v2 = fewer launches for 1-16-row windows (split-K reduced in the matmul, the
# router + top-k + grouping in one kernel, EXL3 experts in 3 kernels, KDA/DSA matmul pairs, the shared expert into its
# slot, unrolled hyper-connection loads); v2,pdl adds programmatic dependent launch (sm_90+). Same bits as unset.
GLM53_TF_DECODE_KERNELS=

# --- operations (scripts/serve.sh; docs/MIA-AUDIT.md) ------------------------------
# every key below is off unless set. Post-load canary: warn (log a failure) | strict (stop both ranks, fail the start)
# CANARY=warn
# CANARY_MIN_TPR=1.3
# CANARY_MIN_TPS=0
# prefill prompts of about these lengths after the canary (first-use graphs / autotune out of the first long request)
# WARMUP_LENGTHS="4096 16384"
# wait for MemFree >= N GiB on both nodes before launching (0: off); pick a few GiB under the idle MemFree after a stop
# MEM_GATE_GIB=90
# MEM_GATE_DROP_CACHES=1
# START_ATTEMPTS=2
# checks before start: warn (log) | strict (refuse); `scripts/serve.sh preflight` runs them on demand
# PREFLIGHT=warn
# container log rotation per container
# LOG_MAX_SIZE=200m
# pass every other NCCL_* key of this file to both ranks
# NCCL_PASSTHROUGH=1
# patches/0150: strict makes /health answer 503 after an engine error or a request without progress for STALL_S s
# (plus its prompt at STALL_PREFILL_TPS before the first token); the watchdog restarts on it
# GLM53_TF_HEALTH=strict
# GLM53_TF_STALL_S=600
# patches/0150: honour OpenAI "reasoning_effort"; default effort of thinking requests (low suits structured output)
# GLM53_TF_EFFORT_FIELD=1
# GLM53_TF_DEFAULT_EFFORT=low
# patches/0210: incremental prompt tokenization across turns (on by default; 0 off; verify: also full-encode, log and
# use it on any difference)
# GLM53_TF_TOKCACHE=verify
# watchdog (serve.sh watch, or scripts/systemd/glm53-tf-watchdog.timer): restart after WATCH_FAILS bad ticks
# WATCH_HEAL=1
# WATCH_ALERT=/usr/local/bin/notify
# WATCH_MIN_TPR=1.5
