--- a/src/tensorfold/cuda/server.py
+++ b/src/tensorfold/cuda/server.py
@@ -738,7 +738,15 @@ class App:
     def prompt_ids(self, text: str) -> list[int]:
         """The rendered prompt's token ids (patches/0210: a family's app may reuse ones it already has)."""
 
-        return self.tok.encode(text, add_special_tokens=False).ids
+        return self._encode_ids(text, False)
+
+    def _encode_ids(self, text: str, special: bool) -> list[int]:
+        """patches/0700: ``self.tok.encode(text, add_special_tokens=special).ids``, the same ids, through
+        ``encode_batch_fast`` on the one text: it tokenizes with Python's GIL released (``encode`` holds it, ~1.2 us a
+        token), so a long prompt no longer stops the batch thread and every other stream while it is tokenized, and it
+        skips the character offsets nothing here reads."""
+
+        return self.tok.encode_batch_fast([text], add_special_tokens=special)[0].ids
 
     def given_ids(self, ids: list[int]) -> list[int]:
         """patches/0490: a request's own token ids (``/v1/completions`` with a token-ID ``prompt``)."""
@@ -768,11 +776,11 @@ class App:
             thinking = bool(kwargs.pop("enable_thinking", self.default_thinking))
             text = self.template.render(body["messages"], tools=body.get("tools") or [], enable_thinking=thinking,
                                         extra=kwargs)
-            return list(self.tok.encode(text, add_special_tokens=False).ids)
+            return list(self._encode_ids(text, False))
         prompt = body.get("prompt")
         if not isinstance(prompt, str):
             raise ValueError("tokenize needs a string prompt or a list of messages")
-        return list(self.tok.encode(prompt, add_special_tokens=bool(body.get("add_special_tokens", True))).ids)
+        return list(self._encode_ids(prompt, bool(body.get("add_special_tokens", True))))
 
