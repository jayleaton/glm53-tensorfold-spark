diff --git a/src/tensorfold/families/glm5_next/cuda/expert_loads.py b/src/tensorfold/families/glm5_next/cuda/expert_loads.py
new file mode 100644
index 0000000..32e8005
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/expert_loads.py
@@ -0,0 +1,183 @@
+"""Decode-window routed experts with a deeper load path (patches/0580): ``exl3_ld.cu``'s ``ld_kernel`` in place of
+exl3.cu's ``grouped_kernel`` for the gate/up and down GEMVs of ``exl3_mm.routed`` (windows of <= 16 rows: decode,
+verify, MTP, DFlash2 and 4-slot windows; longer windows keep ``grouped_loop``), with the bits of exl3.cu.
+
+Knobs (off by default; each rank reads its own, and ranks may differ without changing a bit):
+
+``GLM53_TF_DEC_EXPERT_LOADS=1``      the two grouped launches of a routed layer run ``ld_kernel`` (rot_in and the two
+                                     epilogues are exl3.cu's, unchanged).
+``GLM53_TF_DEC_EXPERT_LOADS_CFG``    "ld,nt,pd" for both matrices, or "ld,nt,pd/ld,nt,pd" (gate/up, down); default
+                                     "nc,8,2". ld: ``nc`` = 16-byte ld.global.nc into registers + a warp staging area
+                                     (W16 littles.cu's winner: 232.7 GB/s at 4 KB an SM in flight), ``w32`` =
+                                     grouped_kernel's 32-bit loads, ``cpa`` = a cp.async ring; nt: column tiles a
+                                     program (8 = grouped_kernel's; 4 = twice the programs, 4 CTAs an SM); pd: k steps in
+                                     flight a warp (1, 2, 4). Every setting places work only.
+``GLM53_TF_DEC_EXPERT_LOADS_PDL=1``  launch ld_kernel as a programmatic dependent (sm_90+; default 0): its prologue (the
+                                     grouping reads and the first k steps of trellis words) overlaps the previous
+                                     kernel's tail; X / Xd are read and Z written after griddepcontrol.wait. Safe
+                                     because the launch before it (rot_in / gateup_epilogue) is a plain launch and the
+                                     grouping is written before routed starts (exl3_ld.cu's header).
+
+Exactness (docs/DECODE-KERNELS-2.md §3): the program grid, each warp's K range (exl3_mm's W = 4 warps and K splits),
+the mma chain per accumulator (k ascending from +0.0, decode_tile's B fragments, load_pair's A values), the warp sum
+order and the Z rows stored are grouped_kernel's; only when and how the bytes arrive changes. So a row's Z, and so Xd
+and Y, are the bits of today's kernel for every row count, and drafted == serial, batched == alone, resumed == fresh
+hold as before. Not used by fast-prefill chunks, windows past 16 rows (grouped_loop) or while 0440's
+GLM53_TF_DEC_EXPERTS / 0130's decode_v2 take the whole routed path.
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from pathlib import Path
+
+from . import exl3_mm
+
+ENV = "GLM53_TF_DEC_EXPERT_LOADS"
+ENV_CFG = "GLM53_TF_DEC_EXPERT_LOADS_CFG"
+LDS = {"nc": 0, "w32": 1, "cpa": 2}
+CFGS = (("nc", 8, 2), ("nc", 8, 1), ("nc", 8, 4), ("nc", 4, 2), ("nc", 4, 4), ("w32", 8, 2), ("w32", 4, 4),
+        ("cpa", 8, 2), ("cpa", 4, 4))
+PROBES = {("nc", 1), ("nc", 2), ("nc", 3), ("w32", 3), ("cpa", 3)}      # at nt 8, pd 2
+DEFAULT = ("nc", 8, 2)
+
+
+def _env(name: str, default: str) -> str:
+    return os.environ.get(name, default).strip().lower()
+
+
+def _cfg(text: str) -> tuple:
+    parts = [p.strip() for p in text.split(",")]
+    try:
+        c = (parts[0], int(parts[1]), int(parts[2]))
+    except (IndexError, ValueError):
+        c = None
+    if c not in CFGS or len(parts) != 3:
+        raise ValueError(f"{ENV_CFG}={os.environ.get(ENV_CFG)!r}: each of gate/up, down must be one of "
+                         f"{', '.join(','.join(map(str, x)) for x in CFGS)}")
+    return c
+
+
+def parse() -> dict:
+    """The knobs, validated (a bad value refuses to start rather than silently running something else)."""
+
+    raw = _env(ENV_CFG, "")
+    if raw:
+        halves = raw.split("/")
+        if len(halves) > 2:
+            raise ValueError(f"{ENV_CFG}={os.environ.get(ENV_CFG)!r}: expected ld,nt,pd or ld,nt,pd/ld,nt,pd")
+        gu = _cfg(halves[0])
+        dn = _cfg(halves[1]) if len(halves) == 2 else gu
+    else:
+        gu = dn = DEFAULT
+    off = ("", "0", "false", "no", "off")
+    return {"on": _env(ENV, "0") not in off, "gu": gu, "dn": dn,
+            "pdl": _env("GLM53_TF_DEC_EXPERT_LOADS_PDL", "0") not in off}
+
+
+CFG = parse()
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    """Built for this GPU's architecture only (as decode_stream's kernels: one arch, one cubin)."""
+
+    import torch
+    from torch.utils.cpp_extension import load
+
+    here = Path(__file__).parent
+    major, minor = torch.cuda.get_device_capability()
+    saved = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    os.environ["TORCH_CUDA_ARCH_LIST"] = f"{major}.{minor}"
+    try:
+        return load(name="tensorfold_glm_exl3_ld_v1", sources=[str(here / "exl3_ld.cpp"), str(here / "exl3_ld.cu")],
+                    extra_cuda_cflags=["-O3"], verbose=False)
+    finally:
+        if saved is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = saved
+
+
+def fits(K: int, N: int, sk: int, w: int, cfg: tuple) -> bool:
+    """Whether (ld, nt, pd) can run a (K, N, K splits, warps) matrix with grouped_kernel's work items."""
+
+    _, nt, pd = cfg
+    if w != 4 or K % (16 * sk * w) or N % (16 * nt):
+        return False
+    per_warp = K // (16 * sk * w)
+    return per_warp >= pd and per_warp % pd == 0
+
+
+@lru_cache(maxsize=None)
+def _pdl_ok(device: int) -> bool:
+    import torch
+
+    return torch.cuda.get_device_capability(device)[0] >= 9
+
+
+def run(x0, x1, t0, t1, group, z, mats: int, K: int, N: int, P: int, sk: int, slots: int, cfg: tuple,
+        probe: int = 0, pdl: bool | None = None) -> None:
+    """One grouped launch through ld_kernel (tests / benches call this directly; probe > 0: timing only)."""
+
+    ld, nt, pd = cfg
+    if probe and (ld, probe) not in PROBES:
+        raise ValueError(f"no probe {probe} for {ld}")
+    pdl = CFG["pdl"] if pdl is None else bool(pdl)
+    pdl = pdl and _pdl_ok(x0.device.index or 0)
+    _ext().grouped(x0, x1, t0, t1, group.ids, group.count, group.members, z, mats, K, N, P, sk, slots, nt, LDS[ld],
+                   pd, probe, pdl)
+
+
+def grouped(x0, x1, t0, t1, group, z, mats: int, K: int, N: int, P: int, sk: int, slots: int, w: int) -> bool:
+    """``exl3_mm.routed``'s ``ext.grouped`` call (not grouped_loop) through ld_kernel, the same Z. False: not
+    taken (the caller runs exl3.cu)."""
+
+    if not CFG["on"]:
+        return False
+    cfg = CFG["dn" if mats == 1 else "gu"]
+    if not fits(K, N, sk, w, cfg) or t0.data_ptr() % 16 or t1.data_ptr() % 16:
+        return False
+    run(x0, x1, t0, t1, group, z, mats, K, N, P, sk, slots, cfg)
+    return True
+
+
+def configure(on: bool | None = None, *, gu: tuple | None = None, dn: tuple | None = None,
+              pdl: bool | None = None) -> dict:
+    """Install the hook as the knobs (or the arguments) say. CUDA graphs keep the kernels they captured."""
+
+    import sys
+
+    if on is not None:
+        CFG["on"] = bool(on)
+    if pdl is not None:
+        CFG["pdl"] = bool(pdl)
+    for k, v in (("gu", gu), ("dn", dn)):
+        if v is not None:
+            v = tuple(v)
+            if v not in CFGS:
+                raise ValueError(f"{k}={v}: one of {CFGS}")
+            CFG[k] = v
+    exl3_mm.LOADS = sys.modules[__name__] if CFG["on"] else None
+    return dict(CFG)
+
+
+class using:
+    """Tests / benches: run with these settings (eager kernels; captured graphs keep theirs), then restore."""
+
+    def __init__(self, **kw) -> None:
+        self.kw, self.saved = kw, None
+
+    def __enter__(self):
+        self.saved = dict(CFG)
+        return configure(**self.kw)
+
+    def __exit__(self, *exc):
+        CFG.clear()
+        CFG.update(self.saved)
+        configure()
+        return False
+
+
+configure()
