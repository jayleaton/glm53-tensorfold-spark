     # -- the round loop ------------------------------------------------------------------------------------------------
+    def _idle_bell(self, *, wait: bool) -> None:
+        """Wake an empty batch through the existing rendezvous store, never a GPU collective.
+
+        Adapted from upstream TensorFold #132. Both ranks know when every sequence has ended; only that
+        boundary rings/waits. Active rounds and sampler-carried plans therefore pay no TCP round trip.
+        RoceComm forwards ``store`` to its NCCL base. Store-less test communicators retain the old exchange.
+        """
+
+        if any(s is not None for s in self.seqs):
+            return
+        store = getattr(getattr(self.g, "comm", None), "store", None)
+        if store is None:
+            return
+        seq = getattr(self, "_idle_bell_seq", 0) + 1
+        key = f"tf_glm_batch_idle_{seq}"
+        if wait:
+            from datetime import timedelta
+
+            while True:
+                try:
+                    store.wait([key], timedelta(hours=1))
+                    break
+                except torch.distributed.DistStoreError as exc:
+                    # Only a genuine idle wait may retry; peer loss and other store errors must fail loudly.
+                    if not str(exc).startswith("wait timeout after "):
+                        raise
+            store.delete_key(key)
+        else:
+            store.set(key, b"1")
+        self._idle_bell_seq = seq
+
     def _serve(self) -> None:
         """Rank 0's loop thread: plan a round (shared with rank 1), run it."""

