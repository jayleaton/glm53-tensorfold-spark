+_GLM_KEY, _GLM_KEY_END, _GLM_VALUE, _GLM_VALUE_END = "<arg_key>", "</arg_key>", "<arg_value>", "</arg_value>"
+_GLM_TAG = re.compile(r"</?arg_(?:key|value)>")
+_LAST_WORD = re.compile(r"(\S+)\s*$")
+
+
+def repair_glm_keys(block: str) -> str:
+    """patches/0690 (``GLM53_TF_TOOL_FIXES=argkeys``; MiaAI-Lab 0055, issue #22, Apache-2.0): a GLM call whose
+    ``<arg_key>`` the model left out, writing whitespace where that token belongs (``read path</arg_key><arg_value>..``,
+    or ``</arg_value>\npath</arg_key>``), with it put back: the word before an unopened ``</arg_key>`` is its key. A
+    block where nothing is missing comes back as it is."""
+
+    if block.count(_GLM_KEY_END) <= block.count(_GLM_KEY):
+        return block
+    out, at, prev, prev_end = [], 0, None, 0     # prev: the last tag seen (ending at prev_end); at: text copied
+    for tag in _GLM_TAG.finditer(block):
+        if tag.group(0) == _GLM_KEY_END and prev in (None, _GLM_VALUE_END):
+            seg_start = 0 if prev is None else prev_end
+            word = _LAST_WORD.search(block, seg_start, tag.start())
+            # the name's segment keeps a name before the key (``read path``): no word, or no name, is not repaired
+            if word is None or (prev is None and not block[seg_start:word.start()].strip()):
+                return block
+            out += [block[at:word.start()], _GLM_KEY]
+            at = word.start()
+        prev, prev_end = tag.group(0), tag.end()
+    return "".join(out) + block[at:]
+
+
+def _whole_glm_call(body: str, tools: list[dict[str, Any]]) -> bool:
+    """patches/0690: ``body`` (between ``<tool_call>`` and ``</tool_call>``) is one GLM call to an offered tool and
+    nothing else (a name, then only ``<arg_key>k</arg_key><arg_value>v</arg_value>`` pairs and whitespace), and it
+    has every parameter the tool's schema lists in ``required`` (a bare name: only a tool that requires none)."""
+
+    name, _ = _glm_call(body, tools)
+    if not name:
+        return False
+    fns = [t.get("function") if isinstance(t.get("function"), dict) else t
+           for t in tools if isinstance(t, dict) and _tool_name(t).lower() == name.lower()]
+    if not fns:
+        return False
+    cut = body.find(_GLM_KEY)
+    if cut >= 0 and _GLM_ARG_RE.sub("", body[cut:]).strip():
+        return False
+    params = fns[-1].get("parameters") if isinstance(fns[-1], dict) else None      # the schema ``_glm_call`` reads
+    required = params.get("required") if isinstance(params, dict) else None
+    keys = {m.group(1).strip() for m in _GLM_ARG_RE.finditer(body)}
+    return all(not isinstance(r, str) or r in keys for r in required) if isinstance(required, list) else True
+
+
+def close_glm_call(text: str, tools: list[dict[str, Any]]) -> str:
+    """patches/0690 (``GLM53_TF_TOOL_FIXES=opencalls``; MiaAI-Lab 0055, issue #22): ``</tool_call>`` when ``text`` (a
+    finished answer) ended inside a GLM call that is complete but for that tag: no argument value open (the model
+    wrote every ``</arg_value>`` itself; a value is never closed here) and, after ``argkeys``' repair, one whole call
+    to an offered tool with every ``required`` parameter (``_whole_glm_call``). "" otherwise: not inside a call, or
+    the call is not complete, and its markup stays the reply's text, as before. Fail-closed on purpose: a value cut
+    mid-string (a shell command, a path) must never run as a call. The caller decides that the model's end token, not
+    a stop string or the token limit, ended the reply."""
+
+    at = text.rfind(_CALL_OPEN)
+    if at < 0 or not tools:
+        return ""
+    block = text[at + len(_CALL_OPEN):]
+    if _CALL_CLOSE in block or _THINK_END in block:
+        return ""
+    if block.rfind(_GLM_VALUE) > block.rfind(_GLM_VALUE_END):          # a value still open: never closed
+        return ""
+    body = repair_glm_keys(block) if "argkeys" in tool_fixes() else block
+    return _CALL_CLOSE if _whole_glm_call(body.strip(), tools) else ""
+
