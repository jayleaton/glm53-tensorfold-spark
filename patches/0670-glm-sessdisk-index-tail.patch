 # -- the index (host only, the same on both ranks) -------------------------------------------------------------------
+SUB = 64            # patches/0670: the in-page granularity ``DiskIndex.lcp`` keeps (every snapshot grid is a multiple)
+
+
+def _sub(ids: Sequence[int]) -> bytes:
+    return hashlib.blake2b(sessions._bytes(ids), digest_size=8).digest()
+
+
+class DiskIds:
+    """patches/0670: an entry's token ids as the in-RAM index keeps them: the length, the chained page digests
+    (``DiskEntry.chain``), an 8-byte digest per SUB tokens of each full page and only the tokens past the last full
+    page (``tail``, int32, < PAGE). The whole ids as a Python ``list[int]`` (8-36 B a token, one list per entry, not
+    shared between entries with a common prefix) made the index grow with traffic until the tier's GiB budget filled
+    (the DeepSeek kit's G18 drift, fixed the same way); this costs ~0.35 B a token. The file header keeps the full ids
+    (``DiskTier._write``) and ``_Load`` reads them from it.
+
+    Enough of a sequence for the index's users: ``len``; equality with a token sequence (exact: length, chain, tail;
+    ``prompt[:n] != entry.ids`` works as with a list); slices / items inside the tail (``SessionIndex._prefix``).
+    Anything else (iteration, an id inside a full page) raises, so nothing silently reads ids that are not here."""
+
+    __slots__ = ("n", "chain", "subs", "tail")
+
+    def __init__(self, ids: Sequence[int], blocks: list[bytes]) -> None:
+        n = len(ids)
+        full = n // PAGE * PAGE
+        self.n = n
+        self.chain = blocks                         # the entry's own chain (shared, not copied)
+        self.subs = b"".join(_sub(ids[a:a + SUB]) for a in range(0, full, SUB))
+        self.tail = array("i", [int(t) for t in ids[full:n]])
+
+    @property
+    def full(self) -> int:
+        return self.n // PAGE * PAGE
+
+    def __len__(self) -> int:
+        return self.n
+
+    def __iter__(self):
+        raise TypeError("a session disk entry keeps only its tail in RAM: read the ids from its file")
+
+    def __getitem__(self, i):
+        full = self.full
+        if isinstance(i, slice):
+            a, b, step = i.indices(self.n)
+            if b <= a:
+                return []
+            if step != 1 or a < full:
+                raise LookupError(f"ids[{i.start}:{i.stop}] of a session disk entry: only [{full}:] is kept in RAM")
+            return self.tail[a - full:b - full].tolist()
+        k = int(i) + (self.n if int(i) < 0 else 0)
+        if not full <= k < self.n:
+            raise LookupError(f"ids[{i}] of a session disk entry: only [{full}:] is kept in RAM")
+        return self.tail[k - full]
+
+    def __eq__(self, other) -> bool:
+        if isinstance(other, DiskIds):
+            return (self.n, self.chain[-1:], self.subs, self.tail) == (other.n, other.chain[-1:], other.subs, other.tail)
+        try:
+            n = len(other)
+        except TypeError:
+            return NotImplemented
+        if n != self.n:
+            return False
+        blocks = self.n // PAGE
+        if blocks and chain(other, blocks)[-1] != self.chain[blocks - 1]:
+            return False
+        return [int(t) for t in other[blocks * PAGE:]] == self.tail.tolist()
+
+    def __ne__(self, other) -> bool:
+        eq = self.__eq__(other)
+        return eq if eq is NotImplemented else not eq
+
+    __hash__ = None
+
+    def __repr__(self) -> str:
+        return f"DiskIds(n={self.n}, tail={len(self.tail)})"
+
+    def lcp(self, prompt: Sequence[int], blocks: list[bytes]) -> int:
+        """The common prefix with ``prompt``: exact past the last full page, else rounded down to SUB tokens (the
+        chain finds the page, the SUB digests the block inside it)."""
+
+        lo, hi = 0, min(len(blocks), len(self.chain))
+        while lo < hi:                  # chained digests: equal at j means equal before j too
+            mid = (lo + hi + 1) // 2
+            if blocks[mid - 1] == self.chain[mid - 1]:
+                lo = mid
+            else:
+                hi = mid - 1
+        k = lo * PAGE
+        if k < self.full:               # inside a full page: whole SUB blocks
+            for j in range(PAGE // SUB):
+                a = k + j * SUB
+                if a + SUB > len(prompt) or _sub(prompt[a:a + SUB]) != self.subs[a // SUB * 8:a // SUB * 8 + 8]:
+                    return a
+            return k + PAGE
+        end = min(len(prompt), self.n)
+        while k < end and prompt[k] == self.tail[k - self.full]:
+            k += 1
+        return k
+
