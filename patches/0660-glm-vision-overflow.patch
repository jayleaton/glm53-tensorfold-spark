+def too_many(n: int, s: "Settings", last: int | None = None) -> VisionError:
+    """patches/0660: the image-count 400, saying the count covers the whole history and how to get out of it."""
+
+    if last is not None and last > s.max_images:
+        return VisionError(f"{last} images in the last message: at most {s.max_images} a request "
+                           "(GLM53_TF_VISION_MAX_IMAGES); send fewer images or raise the server's limit")
+    hint = ("drop older images from the conversation, raise the server's GLM53_TF_VISION_MAX_IMAGES, or set "
+            "GLM53_TF_VISION_OVERFLOW=drop_oldest on the server to replace the oldest images with a text marker")
+    return VisionError(f"{n} images in this request's messages: at most {s.max_images} (GLM53_TF_VISION_MAX_IMAGES). "
+                       "The count includes every image in earlier turns of the conversation, so every later "
+                       f"request carrying this history is refused too: {hint}")
+
+
+def drop_oldest(messages: list, keep: int) -> tuple[list, int]:
+    """patches/0660: ``messages`` with every image part but the newest ``keep`` replaced by the text part
+    ``OMITTED``, and how many were replaced. The input is not modified; malformed image parts count as images (and
+    are dropped, or refused later, like any other)."""
+
+    drop = count_images(messages) - keep
+    if drop <= 0:
+        return messages, 0
+    out, seen = [], 0
+    for m in messages:
+        content = m.get("content") if isinstance(m, dict) else None
+        if not isinstance(content, list) or seen >= drop:
+            out.append(m)
+            continue
+        parts = []
+        for part in content:
+            if isinstance(part, dict) and part.get("type") in IMAGE_TYPES and seen < drop:
+                seen += 1
+                parts.append({"type": "text", "text": OMITTED})
+            else:
+                parts.append(part)
+        out.append(dict(m, content=parts))
+    return out, drop
+
+
+def last_images(messages: list) -> int:
+    """The image parts in the last message (what ``drop_oldest`` must not touch)."""
+
+    return count_images(messages[-1:]) if isinstance(messages, list) and messages else 0
+
