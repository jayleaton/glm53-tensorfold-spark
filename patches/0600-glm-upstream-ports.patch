+                                                   "User-Agent": USER_AGENT})
+        response = connection.getresponse()
+        _remaining(deadline)
+        if response.status in _REDIRECTS:
+            location = response.getheader("Location")
+            if not location:
+                raise ImageFetchError("image redirect has no destination")
+            return None, location, None
+        if response.status != 200:
+            raise ImageFetchError(f"image download returned HTTP {response.status}")
+        if response.getheader("Content-Encoding", "identity").lower() != "identity":
+            raise ImageFetchError("compressed HTTP image responses are unsupported")
+        media = response.getheader("Content-Type", "").split(";", 1)[0].strip().lower()
+        if media not in MEDIA_TYPES:
+            raise ImageFetchError("image URL content type must be JPEG, PNG, WebP or GIF")
+        length = response.getheader("Content-Length")
+        if length is not None:
+            if not length.isascii() or not length.isdecimal() or int(length) > max_bytes:
+                raise ImageFetchError(f"image larger than {max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+        data = bytearray()
+        while len(data) <= max_bytes:
+            try:
+                sock.settimeout(_remaining(deadline))
+            except OSError:
+                # (ours) http.client closed the connection's socket for a ``Connection: close`` / HTTP/1.0 reply; the
+                # body still reads through the response's file, bounded by the watchdog and the deadline
+                pass
+            chunk = response.read1(min(64 * 1024, max_bytes + 1 - len(data)))
+            if not chunk:
+                break
+            data.extend(chunk)
+        if len(data) > max_bytes:
+            raise ImageFetchError(f"image larger than {max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+        _remaining(deadline)
+        return bytes(data), None, media
+    finally:
+        timer.cancel()
+        connection.close()
+        _close_socket(sock)
+
