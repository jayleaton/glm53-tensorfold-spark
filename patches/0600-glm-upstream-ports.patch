+def _closed_value(raw: str, kind: Any) -> Any:
+    """patches/0600: a value that is not JSON as written. When the tool's schema types it as an array / object and it
+    only stops short of its closing brackets (#87: GLM ends a nested argument one ``]`` / ``}`` short), the closed
+    value if it then parses to that type; otherwise the text, as before."""
+
+    if kind in ("array", "object"):
+        fixed = closed_json(raw)
+        if fixed is not None:
+            try:
+                value = json.loads(fixed)
+            except (json.JSONDecodeError, ValueError):
+                return raw
+            if isinstance(value, list if kind == "array" else dict):
+                return value
+    return raw
