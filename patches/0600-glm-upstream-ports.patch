diff --git a/src/tensorfold/server/cancellation.py b/src/tensorfold/server/cancellation.py
new file mode 100644
index 0000000..c38c05d
--- /dev/null
+++ b/src/tensorfold/server/cancellation.py
@@ -0,0 +1,72 @@
+"""patches/0600: a request's "the client has gone" check, from upstream TensorFold (24afe5e, 0.3.6.2's
+``tensorfold/server/cancellation.py`` by nood-co1; MIT License, Copyright (c) 2026 TensorFold contributors), with
+``PrefillGuard`` left out (the Mac lane's) and ``poll`` instead of ``select`` where available.
+
+``socket_cancellation(connection)`` is true once the client closed its end of the socket (a zero-byte ``MSG_PEEK``
+read) or the socket failed. A pipelined next request on a kept-alive connection reads as data, not as a close.
+"""
+
+from __future__ import annotations
+
+import select
+import socket
+import threading
+from typing import Any, Callable
+
+
+class RequestCancelled(Exception):
+    """The client left: nothing more is written for this request. ``result``: what ``App.run`` had so far (for the
+    request log), or None."""
+
+    def __init__(self, message: str = "request cancelled", result: dict[str, Any] | None = None) -> None:
+        super().__init__(message)
+        self.result = result
+
+
+class Cancellation:
+    def __init__(self, disconnected: Callable[[], bool] | None = None):
+        self._event = threading.Event()
+        self._disconnected = disconnected
+
+    def cancel(self) -> None:
+        self._event.set()
+
+    @property
+    def cancelled(self) -> bool:
+        if not self._event.is_set() and self._disconnected is not None and self._disconnected():
+            self.cancel()
+        return self._event.is_set()
+
+    def check(self) -> None:
+        if self.cancelled:
+            raise RequestCancelled("request cancelled")
+
+
+def _readable(connection: socket.socket) -> bool:
+    """Whether a read would not block (data, a close or an error). ``poll`` where the platform has it (ours: select()
+    refuses descriptors past 1023, which a long-running threaded server can reach), else upstream's ``select``."""
+
+    if hasattr(select, "poll"):
+        p = select.poll()
+        p.register(connection, select.POLLIN | select.POLLPRI)
+        return bool(p.poll(0))
+    ready, _, _ = select.select([connection], [], [], 0)
+    return bool(ready)
+
+
+def socket_cancellation(connection: socket.socket) -> Cancellation:
+    def disconnected() -> bool:
+        try:
+            if connection.fileno() < 0:
+                return True
+            if not _readable(connection):
+                return False
+            return connection.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT) == b""
+        except BlockingIOError:
+            return False
+        except OSError:
+            return True
+        except ValueError:
+            return False
+
+    return Cancellation(disconnected)
