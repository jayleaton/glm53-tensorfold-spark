+def parse_numbers(body: dict[str, Any]) -> dict[str, Any]:
+    """patches/0600: a request's sampling and length fields, read strictly (upstream's ``parse_numbers`` rules): no
+    booleans, a finite number (temperature, top_p) or an integral one (top_k, seed, max_tokens; ``20.0`` and ``"20"``
