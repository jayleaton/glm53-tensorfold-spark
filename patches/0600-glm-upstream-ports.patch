+            if redirect == policy.max_redirects:
+                raise ImageFetchError("image download has too many redirects")
+            url = urljoin(url, location)
+    except ImageFetchError:
+        raise
+    except (OSError, ValueError, http.client.HTTPException):
+        raise ImageFetchError("image download failed or timed out") from None
+    raise ImageFetchError("image download failed")
