@@ -0,0 +1,239 @@
+"""patches/0600: bounded image URL retrieval with validated, pinned public addresses, for 0500's ``image_url`` parts.
+
+Ported from upstream TensorFold 391713e (+ 05cbb54, b4042e8): ``tensorfold/vision/images_http.py`` (MIT License,
+Copyright (c) 2026 TensorFold contributors), with these changes for our GLM vision (``vision_prep.load_bytes``):
+
+- ``Policy.http`` (GLM53_TF_VISION_FETCH_HTTP=1, default 0) also takes ``http://`` URLs and any port, and
+  ``Policy.private`` (GLM53_TF_VISION_FETCH_PRIVATE=1, default 0) any resolved address: both for local testing only.
+  Defaults: HTTPS on port 443 to public addresses, exactly upstream's rule.
+- ``image/gif`` is accepted beside JPEG / PNG / WebP (0500 decodes a GIF's first frame, as vLLM does).
+- NAT64 (``64:ff9b::/96``, ``64:ff9b:1::/48``) and IPv4-compatible IPv6 addresses are refused too (they can carry a
+  private IPv4 address).
+- A DNS lookup waits for one of the bounded resolver slots until the deadline instead of failing at once.
+- A reply that closes the connection (``Connection: close``, HTTP/1.0) is read to its end: upstream's per-read
+  ``settimeout`` fails there once ``http.client`` has closed the socket (the watchdog still bounds the read).
+- Messages never contain the URL (the caller's 400 goes to the client, logs are redacted by the server).
+
+What it does (upstream's design): the URL must be ``https`` on 443 with a host, no credentials, fragment, backslash or
+control characters, at most ``max_url_chars``; the host is resolved on a small bounded pool of threads and **every**
+address must be public (``is_global``, not multicast / reserved / 6to4 / Teredo / IPv4-mapped, not 192.0.0.0/24, not
+Azure's 168.63.129.16; this excludes private, loopback, link-local incl. 169.254.169.254, CGNAT 100.64/10 incl.
+100.100.100.200 and fd00:ec2::254); the socket connects to the checked address (no second lookup a rebinding DNS
+could answer differently), TLS verified for the host name; ``identity`` encoding only, a declared image type, at most
+``max_bytes``; each redirect (301/302/303/307/308, at most ``max_redirects``) is checked the same way from the start;
+one deadline covers every step (a watchdog closes the socket if a handshake or header read stalls).
+"""
+
+from __future__ import annotations
+
+import http.client
+import ipaddress
+import queue
+import socket
+import ssl
+import threading
+import time
+from dataclasses import dataclass
+from urllib.parse import quote, urljoin, urlsplit
+
+MEDIA_TYPES = {"image/jpeg": "JPEG", "image/png": "PNG", "image/webp": "WEBP", "image/gif": "GIF"}
+_DNS_SLOTS = threading.BoundedSemaphore(4)
+_REDIRECTS = {301, 302, 303, 307, 308}
+_SPECIAL_V4 = (ipaddress.ip_network("192.0.0.0/24"), ipaddress.ip_network("168.63.129.16/32"))
+_SPECIAL_V6 = (ipaddress.ip_network("64:ff9b::/96"), ipaddress.ip_network("64:ff9b:1::/48"),
+               ipaddress.ip_network("::/96"))
+_BLOCKED_HOSTS = {"localhost", "metadata.google.internal", "instance-data", "metadata"}
+USER_AGENT = "tensorfold-glm53-vision/2"
+
+
+class ImageFetchError(ValueError):
+    """An invalid, inaccessible, or oversized image URL (HTTP 400; ``vision_prep`` re-raises it as VisionError)."""
+
+
+@dataclass(frozen=True)
+class Policy:
+    http: bool = False              # GLM53_TF_VISION_FETCH_HTTP: http:// and any port (local testing)
+    private: bool = False           # GLM53_TF_VISION_FETCH_PRIVATE: any address (local testing)
+    max_redirects: int = 3
+    max_url_chars: int = 4096
+
+
+def _remaining(deadline: float) -> float:
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise ImageFetchError("image download timed out")
+    return remaining
+
+
+def public_ip(value: str) -> bool:
+    """Whether ``value`` is an address a public image host may have (upstream's rule plus NAT64 / IPv4-compatible)."""
+
+    try:
+        address = ipaddress.ip_address(value.split("%", 1)[0])
+    except ValueError:
+        return False
+    if not address.is_global or address.is_multicast or address.is_reserved:
+        return False
+    if isinstance(address, ipaddress.IPv4Address):
+        return not any(address in block for block in _SPECIAL_V4)
+    if address.ipv4_mapped or address.sixtofour or address.teredo:
+        return False
+    return not any(address in block for block in _SPECIAL_V6)
+
+
+def _resolve(host: str, port: int, deadline: float, policy: Policy) -> list[tuple]:
+    """``host``'s addresses, every one checked; a stalled lookup holds one of four resolver threads at most."""
+
+    slots = _DNS_SLOTS
+    if not slots.acquire(timeout=_remaining(deadline)):
+        raise ImageFetchError("image DNS resolver is busy; retry the request")
