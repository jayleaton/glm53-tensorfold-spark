+# -- patches/0570: the dense size switch --------------------------------------------------------------------------------
+MIB = 1 << 20
+
+# W16 cold placement of the switched shapes (results/W16/probes-head/cold.json: every (groups a stage, stages) x
+# split / whole-tile x PDL row had the same bits as _qmm). Per shape and PDL setting (GLM53_TF_DEC_PDL picks the
+# column), the setting with the best geometric mean over the 1-16-row windows in BOTH cold modes -- "flush" (a 64 MiB
+# streaming predecessor before every call, the in-situ-like one) and "rotate" (>= 96 MiB of copies back to back) --
+# and the largest window it still wins at in both: index k loses from 8 rows (flush / rotate 1.07 / 0.97 at 8, 0.76 /
+# 0.72 at 16) and DSA kv_b without PDL at 1-2 rows (0.97 / 0.93; it has no decode call in W11 anyway: 0390's latent
+# kernels absorb it), so they stay on _qmm there. Placement only: no entry changes a bit.
+#   shape: {pdl: (groups a stage, stages, whole-tile items, max rows)}    W16 flush / rotate at 2-4 rows (1-stream)
+SMALL_PLACE = {
+    "4096x128": {False: (1, 8, True, 64), True: (1, 6, True, 64)},        # 1.20 / 1.10 | pdl 1.16 / 1.94
+    "160x4096": {False: (1, 8, False, 4), True: (1, 8, False, 4)},        # 1.21 / 1.25 | pdl 1.15 / 1.46
+    "4096x1024": {False: (1, 4, True, 64), True: (1, 4, True, 64)},       # 1.17 / 1.11 | pdl 1.08 / 1.17
+    "4096x1536": {False: (1, 4, True, 64), True: (1, 4, True, 64)},       # 1.15 / 1.08 | pdl 1.19 / 1.15
+    "8192x512": {False: (1, 4, True, 0), True: (1, 6, True, 64)},         # 1.04 / 0.94 | pdl 1.05 / 1.26
+}
+
+
+def _maxmb() -> float:
+    raw = _env("GLM53_TF_DEC_QMM_MAXMB", "") or _env("GLM53_TF_DEC_QMM_MAX_MB", "") or "0"
+    try:
+        v = float(raw)
+    except ValueError:
+        v = -1.0
+    if not (v >= 0 and v == v and v != float("inf")):
+        raise ValueError(f"GLM53_TF_DEC_QMM_MAXMB={raw!r}: expected a size in MiB >= 0 (0 = off)")
+    return v
+
+
+def small_shape(q, m: int) -> tuple | None:
+    """patches/0570: (the shape key, its SMALL_PLACE entry or None) when the size switch sends this (matrix, rows) to
+    q4_stream.cu; None when it stays on _qmm. Without the size knob every shape qualifies (0440's behaviour)."""
+
+    limit = CFG["qmm_max_bytes"]
+    key = f"{q.n}x{q.k}"
+    if not limit:
+        return key, None
+    info = q.__dict__.get("_dec_small")
+    if info is None or info[0] != limit or info[1] != CFG["qmm_exclude"]:
+        ok = q.nbytes() <= limit and key not in CFG["qmm_exclude"]
+        info = (limit, CFG["qmm_exclude"], ok)
+        q.__dict__["_dec_small"] = info                           # one size check a matrix (host time at 4 streams)
+    if not info[2]:
+        return None
+    place = SMALL_PLACE.get(key) if CFG["qmm_table"] else None
+    if place is not None:
+        place = place[bool(CFG["pdl"]) and pdl_supported()]
+        if m > place[3]:
+            return None
+    return key, place
+
