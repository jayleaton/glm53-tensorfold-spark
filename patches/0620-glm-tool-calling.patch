new file mode 100644
index 0000000..6c24c20
--- /dev/null
+++ i/src/tensorfold/families/glm5_next/cuda/toolfix.py
@@ -0,0 +1,270 @@
+"""patches/0620: tool-calling fixes for multi-step chains (``GLM53_TF_TOOL_FIXES``, off by default; docs/TOOL-CALLING.md).
+
+Host only, rank 0's HTTP app; the engine, its tokens and every request without tools are untouched. Each fix is named
+in the comma list (``all`` = every one but ``grammar``):
+
+- ``history``: the request's messages as the chat template expects them. ``content: null`` (OpenAI's shape for an
+  assistant turn that only calls tools, and what this server answers) rendered as the literal text ``None`` before
+  the calls (and in a null tool result); it is now ``""``. An assistant turn's ``reasoning`` (the field this server
+  answers with GLM53_TF_REASONING_FIELDS=reasoning) is copied to ``reasoning_content`` (the only name the template
+  reads) when that is absent (``reasoning`` does this too). Tool-call ``arguments`` of ``""`` / null are ``{}`` (the template called ``.items()`` on
+  the string: HTTP 400).
+- ``reasoning``: the reasoning of each reply that called tools is kept, keyed by the call ids this server made
+  (``call_<24 hex>``, unique) and by a signature of the calls (names, arguments) with the last user message before
+  them (for clients that renumber the ids), and put back into a later request's assistant turn that carries those
+  calls without reasoning. GLM-5.3's template keeps the reasoning of every assistant turn after the last user
+  message (interleaved thinking inside one tool loop); clients that drop ``reasoning_content`` otherwise make every
+  earlier step of the chain render as ``<think></think>``, which the model never produced. Bounded:
+  GLM53_TF_KEEP_REASONING_ENTRIES (1024) replies and GLM53_TF_KEEP_REASONING_MB (32) of text, oldest dropped.
+- ``choice``: OpenAI ``tool_choice`` and ``parallel_tool_calls`` as upstream TensorFold 0.5.0 reads them
+  (``server/tools.py``): ``"none"`` offers no tools (the template lists none and nothing is parsed as a call), a
+  named function offers only that tool (an unknown name is a 400), ``parallel_tool_calls: false`` keeps the first
+  call. ``"required"`` / named calls are enforced by 0610's grammar (GLM53_TF_GRAMMAR=1), unchanged.
+- ``args``: argument values typed by the whole parameter schema (``server.typed_value``: type lists, anyOf / oneOf,
+  enums, quoted numbers, integral floats) instead of its ``type`` string only.
+- ``thinkcalls``: a reply that ends on ``<|observation|>`` (the model waits for a tool result) with no call in its
+  answer but complete ``<tool_call>`` blocks at the end of its reasoning (thinking never closed, or the calls written
+  inside it) returns those calls (``finish_reason: tool_calls``) instead of an empty answer.
+- ``grammar`` (with GLM53_TF_GRAMMAR=1): every tools request with ``tool_choice`` auto / absent is held to the tools'
+  schemas by 0610's structural tag, as ``"strict": true`` tools are (text stays free; a call's name and arguments
+  must fit). Costs 0610's mask fills on that request's rows.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import threading
+from collections import OrderedDict
+from typing import Any
+
+from tensorfold.cuda.server import TOOL_FIXES_ENV, parse_tool_calls, tool_fixes
+
+_CALL_ID = re.compile(r"^call_[0-9a-f]{24}$")
+_CALL_BLOCK = re.compile(r"<tool_call>.*?</tool_call>", re.DOTALL)
+
+
+def _int_env(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        value = int(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected an integer") from None
+    if value < 0:
+        raise ValueError(f"{name}={raw!r}: expected >= 0")
+    return value
+
+
+class ReasoningMemory:
+    """The reasoning of recent replies that called tools (LRU, bounded in entries and characters), found by any of
+    its keys: the call ids this server made, and a signature of the calls with the last user message before them
+    (clients that renumber the ids, as spark-bench does). A key put again points at the newer reply."""
+
+    def __init__(self, entries: int = 1024, chars: int = 32 << 20) -> None:
+        self.entries, self.chars = int(entries), int(chars)
+        self.items: OrderedDict[int, tuple[str, tuple[str, ...]]] = OrderedDict()
+        self.by_key: dict[str, int] = {}
+        self.size = 0
+        self.next = 0
+        self.lock = threading.Lock()
+
+    def put(self, keys: list[str], reasoning: str) -> None:
+        keys = [k for k in keys if isinstance(k, str) and k]
+        if not keys or not reasoning or self.entries == 0 or len(reasoning) > self.chars:
+            return
+        with self.lock:
+            n, self.next = self.next, self.next + 1
+            self.items[n] = (reasoning, tuple(keys))
+            self.size += len(reasoning)
+            for k in keys:
+                self.by_key[k] = n
+            while self.items and (len(self.items) > self.entries or self.size > self.chars):
+                old, (text, old_keys) = self.items.popitem(last=False)
+                self.size -= len(text)
+                for k in old_keys:
+                    if self.by_key.get(k) == old:
+                        del self.by_key[k]
+
+    def get(self, keys: list[str]) -> str | None:
+        with self.lock:
+            for k in keys:
+                n = self.by_key.get(k) if isinstance(k, str) else None
+                if n is not None:
+                    self.items.move_to_end(n)
+                    return self.items[n][0]
+        return None
+
+    def __len__(self) -> int:
+        return len(self.items)
+
+
+def _text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        return "".join(p.get("text", "") if isinstance(p, dict) and isinstance(p.get("text"), str) else
+                       (p if isinstance(p, str) else "") for p in content)
+    return ""
+
+
+def _arguments(value: Any) -> Any:
+    if isinstance(value, str):
+        try:
+            return json.loads(value) if value.strip() else {}
+        except (json.JSONDecodeError, ValueError):
+            return value
+    return {} if value is None else value
+
+
+def signature(user: str, calls: list[Any]) -> str:
+    """The key of a reply's calls after the user message ``user``: names and arguments, canonical JSON."""
+
+    shape = []
+    for c in calls:
+        fn = c.get("function") if isinstance(c, dict) and isinstance(c.get("function"), dict) else (c or {})
+        shape.append([str(fn.get("name") or ""), _arguments(fn.get("arguments"))])
+    text = json.dumps([user, shape], ensure_ascii=False, sort_keys=True, separators=(",", ":"), default=str)
+    return "sig:" + hashlib.sha256(text.encode("utf-8", "surrogatepass")).hexdigest()
+
+
+def last_user(messages: list[Any], before: int | None = None) -> str:
+    """The text of the last user message (before index ``before``)."""
+
+    for m in reversed(messages[:before] if before is not None else messages):
+        if isinstance(m, dict) and m.get("role") == "user":
+            return _text(m.get("content"))
+    return ""
+
+
+class ToolFixes:
+    """The fixes GLM53_TF_TOOL_FIXES names, for one app (``GlmApp``)."""
+
+    def __init__(self, observation_id: int | None, raw: str | None = None) -> None:
+        self.on = tool_fixes(raw)
+        self.observation = observation_id
+        self.memory = ReasoningMemory(_int_env("GLM53_TF_KEEP_REASONING_ENTRIES", 1024),
+                                      _int_env("GLM53_TF_KEEP_REASONING_MB", 32) << 20) \
+            if "reasoning" in self.on else None
+
+    def __bool__(self) -> bool:
+        return bool(self.on)
+
+    def describe(self) -> str:
+        return f"{TOOL_FIXES_ENV}={','.join(sorted(self.on))}"
+
+    # -- the request -------------------------------------------------------------------------------------------
+
+    def prepare(self, body: dict[str, Any]) -> str | None:
+        """Fix ``body`` in place before it is rendered (``check``, ``tokenize`` and ``run`` all call it: idempotent).
+        Returns an error message (HTTP 400) or None."""
+
+        if not self.on or not isinstance(body, dict):
+            return None
+        if "choice" in self.on:
+            problem = self._choice(body)
+            if problem:
+                return problem
+        messages = body.get("messages")
+        if not isinstance(messages, list):
+            return None
+        for i, m in enumerate(messages):
+            if not isinstance(m, dict):
+                continue
+            if "history" in self.on:
+                _history(m)
+            if (self.memory is not None or "history" in self.on) and m.get("role") == "assistant" \
+                    and not isinstance(m.get("reasoning_content"), str) and isinstance(m.get("reasoning"), str):
+                m["reasoning_content"] = m["reasoning"]         # the only name the template reads
+            if self.memory is not None and m.get("role") == "assistant" and isinstance(m.get("tool_calls"), list) \
+                    and m["tool_calls"] and not isinstance(m.get("reasoning_content"), str) \
+                    and "</think>" not in _text(m.get("content")):
+                ids = [c.get("id") for c in m["tool_calls"] if isinstance(c, dict)]
+                keys = [k for k in ids if isinstance(k, str) and _CALL_ID.match(k)]
+                kept = self.memory.get(keys + [signature(last_user(messages, i), m["tool_calls"])])
+                if kept is not None:
+                    m["reasoning_content"] = kept
+        return None
+
+    def _choice(self, body: dict[str, Any]) -> str | None:
+        choice = body.get("tool_choice")
+        tools = body.get("tools")
+        if not tools or not isinstance(tools, list):
+            return None
+        if isinstance(choice, str) and choice.strip().lower() == "none":
+            body["tools"] = []
+            return None
+        if isinstance(choice, dict) and str(choice.get("type") or "").lower() == "function":
+            fn = choice.get("function")
+            name = str(fn.get("name") or "").strip() if isinstance(fn, dict) else ""
+            if not name:
+                return 'tool_choice {"type": "function"} needs {"function": {"name": ...}}'
+            kept = [t for t in tools if _name(t) == name]
+            if not kept:
+                return f"tool_choice names the tool {name!r}, which the request does not offer"
+            body["tools"] = kept
+        return None
+
+    # -- the reply ---------------------------------------------------------------------------------------------
+
+    def reply(self, body: dict[str, Any], *, content: str, calls, reasoning: str, last: int | None,
+              thinking: bool, stopped: bool):
+        """(content, calls, reasoning) of a finished reply with tools, fixed."""
+
+        if not self.on:
+            return content, calls, reasoning
+        tools = body.get("tools") or []
+        if "thinkcalls" in self.on and not calls and thinking and not stopped and not content.strip() \
+                and last is not None and last == self.observation and "<tool_call>" in reasoning:
+            head, tail = trailing_calls(reasoning)
+            if tail:
+                _, found = parse_tool_calls(tail, tools)
+                if found:
+                    calls, reasoning = found, head
+        if "choice" in self.on and calls and body.get("parallel_tool_calls") is False:
+            calls = calls[:1]
+        if self.memory is not None and calls and thinking and reasoning:
+            messages = body.get("messages") if isinstance(body.get("messages"), list) else []
+            self.memory.put([c.get("id") for c in calls] + [signature(last_user(messages), calls)], reasoning)
+        return content, calls, reasoning
+
+
+def _name(tool: Any) -> str:
+    if not isinstance(tool, dict):
+        return ""
+    fn = tool.get("function") if isinstance(tool.get("function"), dict) else tool
+    return str(fn.get("name") or "").strip()
+
+
+def _history(m: dict[str, Any]) -> None:
+    """One message as the template expects it (``history``)."""
+
+    if "content" in m and m["content"] is None:
+        m["content"] = ""
+    if m.get("role") != "assistant":
+        return
+    for call in m.get("tool_calls") or []:
+        fn = call.get("function") if isinstance(call, dict) else None
+        if isinstance(fn, dict) and (fn.get("arguments") is None
+                                     or (isinstance(fn.get("arguments"), str) and not fn["arguments"].strip())):
+            fn["arguments"] = {}
+
+
+def trailing_calls(text: str) -> tuple[str, str]:
+    """(the text before, the run of complete ``<tool_call>`` blocks that ends ``text``): the blocks separated by
+    whitespace only, up to the end but for whitespace and a closing ``</think>``. ``("text", "")`` without one."""
+
+    end = text.rstrip()
+    if end.endswith("</think>"):
+        end = end[: -len("</think>")].rstrip()
+    start = len(end)
+    for m in reversed(list(_CALL_BLOCK.finditer(end))):
+        if end[m.end():start].strip():
+            break
+        start = m.start()
+    if start == len(end):
+        return text, ""
+    return text[:start].rstrip(), end[start:]
