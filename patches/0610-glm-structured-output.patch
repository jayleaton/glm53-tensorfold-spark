new file mode 100644
index 0000000..480bcc2
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/grammar.py
@@ -0,0 +1,891 @@
+"""patches/0610 (GLM53_TF_GRAMMAR=1, off by default): structured output for GLM-5.3-Flash, exact under drafting and
+batching.
+
+What a request gets (only with the knob on; off, every field below is ignored as before):
+
+- OpenAI ``response_format`` ``{"type": "json_object"}`` (any JSON object) and ``{"type": "json_schema",
+  "json_schema": {"schema": {...}}}``; vLLM's ``guided_json`` / ``guided_regex`` / ``guided_choice`` /
+  ``guided_grammar`` and ``structured_outputs`` (as TensorFold 0.5.0 reads them);
+- tool calls: with ``tools`` and ``tool_choice`` ``"required"`` or a named function, or any tool marked
+  ``"strict": true`` (OpenAI's strict function calling), the answer follows GLM's tool-call markup
+  (``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>``) with the arguments held to each
+  tool's parameter schema (xgrammar's ``glm_4_7`` structural tag, ``glm_xml`` style: a string value raw, any other
+  value JSON, as ``server._glm_call`` reads them). Other tool requests are not constrained.
+
+A request that asks for none of these runs exactly as before (no grammar object exists for it).
+
+The grammar engine is xgrammar (Apache-2.0; ``xgrammar==0.2.8`` in the image), as upstream TensorFold 0.5.0 uses.
+Its token masks are computed from the checkpoint's ``tokenizer.json`` (the ``tokenizers`` library, no transformers
+tokenizer object) with the logits' width from ``config.json`` (154,880). GLM's added tokens (``<|user|>``,
+``<think>``, ``</think>``, image markers, ...) are never allowed inside a grammar (upstream lets them spell their text
+inside JSON strings); the stop tokens (the engine's eos ids) are allowed where the grammar may end. Tool grammars keep
+the six tool-call markup tokens, which the model emits as single tokens.
+
+Thinking. The grammar applies to the visible answer only: when the prompt ends inside an open ``<think>`` block
+(the chat template with thinking on), rows are unconstrained until ``</think>`` has been chosen, and the grammar
+starts at the row after it. With thinking off (``<think></think>`` in the prompt) or a raw completion prompt it starts
+at the first token. Reasoning tokens are therefore the unconstrained reply's tokens, bit for bit.
+
+The exactness argument (docs/UPSTREAM-050-AUDIT.md 2.1, docs/STRUCTURED-OUTPUT.md):
+
+- a verify window is a chain: row 0 the pending token, rows 1.. drafts. Before the forward, ``Constraint.cut`` walks
+  the drafts on the matcher (accept, then roll back): a draft the grammar rejects, or one that ends it (its stop
+  token), is dropped with every row after it; the parent row's masked distribution could never choose it. Only R
+  changes, and every kernel is row-count invariant;
+- a kept row's mask depends only on its own path (committed tokens + the drafts above it), which for every row that
+  is kept is the serial prefix at that position, so it is the serial step's mask;
+- ``apply`` sets the disallowed columns of a constrained row to -inf before the sampler's top-k; the keyed draw
+  (seed, position, token) then chooses among the allowed tokens exactly as the unmasked rule chooses among all of
+  them. Each rank masks its own vocabulary half (``w.vocab_offset``); the candidates' all-gather (RoCE) is unchanged;
+- ``advance`` follows the chosen tokens (the kept ones and the correction), so the next window starts at the reply's
+  committed state.
+
+So a constrained drafted reply equals the same request with ``"draft": false``, and a constrained slot among four
+equals itself alone.
+
+Overlap. Only the cut must precede the forward. The masks (``Constraint.fill``: accept along the kept chain, fill a
+row, roll back) are computed while the forward runs: on ``GLM53_TF_GRAMMAR_THREADS`` worker threads (default 4; the
+fill is C++ that releases the GIL) started right after the cut, and waited for just before the sampler
+(``Filler``); 0 fills on the round's thread after the forward's launch. Same masks either way.
+
+Two ranks. Both compile the same grammar: rank 0 sends (kind, think state, text) in front of the request header
+(``pack``: a negative first int, which no header has) and rank 1 compiles it (``Grammars.follow``). Both walk and fill
+the same rows (the same tokens, a deterministic matcher), so both cut the same drafts and end a request on a grammar
+failure at the same point without a message.
+
+Parts ported from TensorFold 0.5.0 (``src/tensorfold/engine/grammar.py``, commits 98fb8f9 and 1da4b7e by the
+TensorFold contributors, MIT License): ``request_spec``'s field handling, the compile rules (json_object as
+``{"type": "object"}``, at most 32 blanks between JSON tokens, choice / EBNF), the depth-first cut with rollback,
+the bitmask unpacking and the ``advance`` rule. Our own: chain windows with fills after the cut (off the critical
+path), the tool-call grammars, the added-token policy, the think state read from the prompt, the batcher and
+two-rank wiring.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Sequence
+
+import numpy as np
+
+ENV = "GLM53_TF_GRAMMAR"
+KINDS = ("json", "json_schema", "regex", "choice", "grammar", "tools")
+OBJECT = '{"type": "object"}'             # json_object: any JSON object (OpenAI's contract), not an array
+BLANKS = 32                               # the most blank characters between JSON tokens (upstream 1da4b7e)
+CACHE_BYTES = 128 << 20                   # compiled grammars kept per tokenizer view, by their text
+THINK_OPEN, THINK_END = "<think>", "</think>"
+TOOL_TOKENS = ("<tool_call>", "</tool_call>", "<arg_key>", "</arg_key>", "<arg_value>", "</arg_value>")
+FIELDS = ("response_format", "guided_json", "guided_regex", "guided_choice", "guided_grammar", "structured_outputs")
+MARK = -1                                 # ``pack``: the first int of a header that carries a grammar
+EXTRA = "xgrammar==0.2.8"
+
+
+def enabled() -> bool:
+    """GLM53_TF_GRAMMAR: 0 (default: request grammar fields are ignored, as before) or 1."""
+
+    v = os.environ.get(ENV, "0").strip() or "0"
+    if v not in ("0", "1"):
+        raise ValueError(f"{ENV}={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+def threads() -> int:
+    """GLM53_TF_GRAMMAR_THREADS: mask-fill worker threads (default 4; 0: fill on the round's thread after the forward
+    is launched). Rank-local: the masks are the same either way."""
+
+    v = os.environ.get("GLM53_TF_GRAMMAR_THREADS", "").strip()
+    n = int(v) if v else 4
+    if not 0 <= n <= 64:
+        raise ValueError(f"GLM53_TF_GRAMMAR_THREADS={n}: expected 0..64")
+    return n
+
+
+class GrammarError(RuntimeError):
+    """A reply's grammar failed mid-reply: that request ends with this error (HTTP 500 / a stream error event), the
+    server and the other requests go on."""
+
+
+# -- request fields -----------------------------------------------------------------------------------------------
+@dataclass(frozen=True)
+class Spec:
+    """A request's structured output: ``kind`` (``KINDS``) and its canonical text."""
+
+    kind: str
+    text: str = ""
+    field: str = "response_format"        # the request field it came from, for error messages
+
+
+def _schema_text(value: Any, where: str) -> str:
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f"{where} is not valid JSON: {exc.msg}") from None
+    if isinstance(value, bool):
+        value = {} if value else None
+    if not isinstance(value, dict):
+        raise ValueError(f"{where} must be a JSON schema object")
+    return json.dumps(value, ensure_ascii=False)
+
+
+def _text(value: Any, where: str) -> str:
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{where} must be a non-empty string")
+    return value
+
+
+def _choices(value: Any, where: str) -> str:
+    if not isinstance(value, list) or not value or not all(isinstance(v, str) and v for v in value):
+        raise ValueError(f"{where} must be a non-empty list of non-empty strings")
+    return json.dumps(value, ensure_ascii=False)
+
+
+def _output_spec(body: dict[str, Any]) -> Spec | None:
+    """``response_format`` / ``guided_*`` / ``structured_outputs`` (upstream 98fb8f9's rules)."""
+
+    rf = body.get("response_format")
+    if rf is not None:
+        if not isinstance(rf, dict):
+            raise ValueError('response_format must be an object such as {"type": "json_object"}')
+        kind = rf.get("type")
+        if kind == "json_object":
+            return Spec("json")
+        if kind == "json_schema":
+            js = rf.get("json_schema")
+            if not isinstance(js, dict) or js.get("schema") is None:
+                raise ValueError("response_format json_schema needs json_schema.schema (a JSON schema object)")
+            return Spec("json_schema", _schema_text(js["schema"], "response_format json_schema.schema"))
+        if kind != "text":
+            raise ValueError(f"response_format type must be text, json_object or json_schema, not {kind!r}")
+    guided = {"guided_json": ("json_schema", _schema_text), "guided_regex": ("regex", _text),
+              "guided_choice": ("choice", _choices), "guided_grammar": ("grammar", _text)}
+    for name, (kind, read) in guided.items():
+        if body.get(name) is not None:
+            return Spec(kind, read(body[name], name), name)
+    so = body.get("structured_outputs")
+    if so is not None:
+        if not isinstance(so, dict):
+            raise ValueError('structured_outputs must be an object such as {"json": {...}}')
+        given = sorted(k for k, v in so.items() if v is not None and v is not False)
+        known = {"json": ("json_schema", _schema_text), "regex": ("regex", _text), "choice": ("choice", _choices),
+                 "grammar": ("grammar", _text)}
+        other = [k for k in given if k not in known and k != "json_object"]
+        if other:
+            raise ValueError(f"structured_outputs {', '.join(other)} is not supported: use json, json_object, regex, "
+                             "choice or grammar")
+        for name in given:
+            if name in known:
+                kind, read = known[name]
+                return Spec(kind, read(so[name], f"structured_outputs.{name}"), "structured_outputs")
+        if so.get("json_object"):
+            return Spec("json", field="structured_outputs")
+    return None
+
+
+def _function(tool: Any) -> dict | None:
+    if not isinstance(tool, dict) or tool.get("type", "function") != "function":
+        return None
+    fn = tool.get("function")
+    return fn if isinstance(fn, dict) else None
+
+
+def _tool_spec(body: dict[str, Any]) -> Spec | None:
+    """Tool calls held to their schemas: ``tools`` with ``tool_choice`` ``"required"`` / a named function, or any
+    function marked ``"strict": true``. ``tool_choice`` ``"none"`` and plain ``"auto"`` requests are not
+    constrained."""
+
+    tools = body.get("tools")
+    if not tools:
+        return None
+    if not isinstance(tools, list):
+        raise ValueError("tools must be a list")
+    fns = [_function(t) for t in tools]
+    choice = body.get("tool_choice")
+    if choice is None or choice == "auto":
+        if not any(fn is not None and fn.get("strict") is True for fn in fns):
+            return None
+        choice = "auto"
+    elif choice == "none":
+        return None
+    elif choice != "required":
+        if not (isinstance(choice, dict) and choice.get("type") == "function"
+                and isinstance(choice.get("function"), dict) and isinstance(choice["function"].get("name"), str)):
+            raise ValueError('tool_choice must be "none", "auto", "required" or {"type": "function", "function": '
+                             '{"name": ...}}')
+        choice = {"type": "function", "function": {"name": choice["function"]["name"]}}
+    kept = []
+    for fn in fns:
+        if fn is None:
+            continue
+        if not isinstance(fn.get("name"), str) or not fn["name"]:
+            raise ValueError("every function tool needs a name")
+        entry = {"name": fn["name"]}
+        if fn.get("parameters") is not None:
+            if not isinstance(fn["parameters"], dict):
+                raise ValueError(f"tool {fn['name']}: parameters must be a JSON schema object")
+            entry["parameters"] = fn["parameters"]
+        if "strict" in fn:
+            entry["strict"] = bool(fn["strict"])
+        kept.append({"type": "function", "function": entry})
+    if not kept:
+        return None
+    parallel = body.get("parallel_tool_calls", True) is not False
+    return Spec("tools", json.dumps({"tools": kept, "tool_choice": choice, "parallel_tool_calls": parallel},
+                                    ensure_ascii=False), "tools")
+
+
+def request_spec(body: dict[str, Any]) -> Spec | None:
+    """The body's structured output, None for plain text; ValueError (HTTP 400) when it is malformed. An output format
+    wins over strict tools (the reply is then JSON, so no call can be made); with a required / named tool call it is
+    refused (upstream's rule)."""
+
+    out = _output_spec(body)
+    tools = _tool_spec(body)
+    if out is not None and tools is not None:
+        choice = body.get("tool_choice")
+        if choice == "required" or isinstance(choice, dict):
+            raise ValueError(f'{out.field} cannot be combined with tool_choice "required" or a named function: '
+                             "send one")
+        return out
+    return out if out is not None else tools
+
+
+def _message(exc: Exception) -> str:
+    """xgrammar's error without its timestamp and source location (upstream)."""
+
+    text = str(exc).strip().splitlines()[0] if str(exc).strip() else type(exc).__name__
+    return re.sub(r"^\[[^\]]*\]\s*\S+:\d+:\s*", "", text)
+
+
+# -- the compiler -------------------------------------------------------------------------------------------------
+@dataclass
+class Bound:
+    """A request's compiled grammar and where it starts: ``active`` from the first token (thinking off, a raw
+    prompt), else after ``think_end`` is chosen."""
+
+    spec: Spec
+    compiled: Any
+    think_end: int
+    active: bool
+
+
+def think_active(prompt: Sequence[int], open_id: int, end_id: int) -> bool:
+    """False when ``prompt`` ends inside an open think block (its last ``<think>`` after its last ``</think>``)."""
+
+    for t in reversed(prompt):
+        if t == end_id:
+            return True
+        if t == open_id:
+            return False
+    return True
+
+
+def _vocab(tokenizer_json: Path, vocab_size: int, keep: Sequence[str]) -> tuple[list[str], dict, int, int]:
+    """(encoded vocabulary of ``vocab_size`` entries, backend metadata, <think> id, </think> id): every added token
+    empty (never allowed but as a stop token) except ``keep``; padded rows empty."""
+
+    from tokenizers import Tokenizer
+
+    tok = Tokenizer.from_file(str(tokenizer_json))
+    vocab = tok.get_vocab(with_added_tokens=True)
+    if max(vocab.values()) >= vocab_size:
+        raise ValueError(f"tokenizer ids reach {max(vocab.values())}, the logits have {vocab_size} columns")
+    enc = [""] * vocab_size
+    for s, i in vocab.items():
+        enc[i] = s
+    added = json.loads(Path(tokenizer_json).read_text()).get("added_tokens") or []
+    for a in added:
+        if a.get("content") not in keep and 0 <= int(a["id"]) < vocab_size:
+            enc[int(a["id"])] = ""
+    backend = tok.to_str()
+    open_id, end_id = tok.token_to_id(THINK_OPEN), tok.token_to_id(THINK_END)
+    return enc, backend, -1 if open_id is None else int(open_id), -1 if end_id is None else int(end_id)
+
+
+class Grammars:
+    """xgrammar compilers for one checkpoint: ``text`` (JSON, regex, choice, EBNF: every added token excluded) and
+    ``tools`` (the tool-call markup tokens kept), compiled grammars cached by their text."""
+
+    def __init__(self, xgr, text_info, tools_info, vocab_size: int, stop_ids: Sequence[int], think_open: int,
+                 think_end: int) -> None:
+        self.xgr = xgr
+        self.vocab_size = int(vocab_size)
+        self.stop_ids = tuple(int(t) for t in stop_ids)
+        self.think_open, self.think_end = int(think_open), int(think_end)
+        self.compilers = {"text": xgr.GrammarCompiler(text_info, max_threads=8, cache_limit_bytes=CACHE_BYTES),
+                          "tools": xgr.GrammarCompiler(tools_info, max_threads=8, cache_limit_bytes=CACHE_BYTES)}
+        # tokens no grammar takes (added / padded, not a stop token): a draft of one is cut without asking the matcher
+        # (which would log a warning for each)
+        self.special = {k: frozenset(int(t) for t in info.special_token_ids) - frozenset(self.stop_ids)
+                        for k, info in (("text", text_info), ("tools", tools_info))}
+        self.lock = threading.Lock()              # requests compile on their HTTP threads, rank 1 on its loop
+
+    @classmethod
+    def from_model(cls, model_dir: str | Path, vocab_size: int, stop_ids: Sequence[int]) -> "Grammars":
+        import xgrammar as xgr
+
+        path = Path(model_dir) / "tokenizer.json"
+        infos = []
+        for keep in ((), TOOL_TOKENS):
+            enc, backend, t_open, t_end = _vocab(path, vocab_size, keep)
+            meta = xgr.TokenizerInfo._detect_metadata_from_hf(backend)   # as ``TokenizerInfo.from_huggingface``
+            infos.append(xgr.TokenizerInfo(enc, meta["vocab_type"], vocab_size=vocab_size,
+                                           stop_token_ids=list(stop_ids), add_prefix_space=meta["add_prefix_space"]))
+        return cls(xgr, infos[0], infos[1], vocab_size, stop_ids, t_open, t_end)
+
+    def compile(self, spec: Spec):
+        """The compiled grammar, or ValueError naming what the request's grammar gets wrong (HTTP 400)."""
+
+        try:
+            with self.lock:
+                if spec.kind == "tools":
+                    d = json.loads(spec.text)
+                    tag = self.xgr.get_model_structural_tag("glm_4_7", tools=d["tools"], tool_choice=d["tool_choice"],
+                                                             reasoning="disabled", max_whitespace_cnt=BLANKS,
+                                                             parallel_tool_calls=bool(d["parallel_tool_calls"]))
+                    return self.compilers["tools"].compile_structural_tag(tag)
+                c = self.compilers["text"]
+                if spec.kind in ("json", "json_schema"):
+                    return c.compile_json_schema(OBJECT if spec.kind == "json" else spec.text,
+                                                 max_whitespace_cnt=BLANKS)
+                if spec.kind == "regex":
+                    return c.compile_regex(spec.text)
+                if spec.kind == "choice":
+                    options = " | ".join(json.dumps(v, ensure_ascii=False) for v in json.loads(spec.text))
+                    return c.compile_grammar("root ::= " + options)
+                return c.compile_grammar(spec.text)
+        except (RuntimeError, ValueError, TypeError, KeyError) as exc:
+            raise ValueError(f"{spec.field}: the grammar cannot be enforced: {_message(exc)}") from None
+
+    def bind(self, spec: Spec, compiled, prompt: Sequence[int]) -> Bound:
+        return Bound(spec, compiled, self.think_end, think_active(prompt, self.think_open, self.think_end))
+
+    def constraint(self, bound: Bound) -> "Constraint":
+        view = "tools" if bound.spec.kind == "tools" else "text"
+        return Constraint(self.xgr.GrammarMatcher(bound.compiled), self.vocab_size, think_end=bound.think_end,
+                          active=bound.active, never=self.special[view])
+
+    def follow(self, payload: Sequence[int]) -> Bound:
+        """The grammar another rank ``pack``ed, compiled here: both ranks then walk and mask the same rows."""
+
+        kind, end1, active, n = (int(v) for v in payload[:4])
+        text = _unpack_bytes(payload[4:], n).decode()
+        spec = Spec(KINDS[kind], text)
+        return Bound(spec, self.compile(spec), end1 - 1, bool(active))
+
+
+def _pack_bytes(data: bytes) -> list[int]:
+    """3 bytes an int (non-negative int32 words through the all-gather)."""
+
+    data = data + b"\0" * (-len(data) % 3)
+    return [data[i] | data[i + 1] << 8 | data[i + 2] << 16 for i in range(0, len(data), 3)]
+
+
+def _unpack_bytes(words: Sequence[int], n: int) -> bytes:
+    out = bytearray()
+    for v in words:
+        v = int(v)
+        out += bytes((v & 255, v >> 8 & 255, v >> 16 & 255))
+    return bytes(out[:n])
+
+
+def pack(bound: Bound) -> list[int]:
+    """A request's grammar for the other rank, in front of its header: [MARK, n, kind, think_end + 1, active, bytes,
+    *3-byte words]."""
+
+    data = bound.spec.text.encode()
+    body = [KINDS.index(bound.spec.kind), int(bound.think_end) + 1, int(bound.active), len(data), *_pack_bytes(data)]
+    return [MARK, len(body), *body]
+
+
+def split(ints: Sequence[int]) -> tuple[list[int] | None, list[int]]:
+    """``pack``'s prefix off a header: (the packed grammar or None, the header as it was)."""
+
+    ints = [int(v) for v in ints]
+    if ints and ints[0] == MARK:
+        n = ints[1]
+        return ints[2:2 + n], ints[2 + n:]
+    return None, ints
+
+
+# -- one reply's grammar state --------------------------------------------------------------------------------------
+@dataclass
+class Window:
+    """A verify window the grammar keeps: its tokens (row 0 the pending token), the rows it constrains (in order) and,
+    after ``Constraint.fill``, their allowed-token bits ([len(rows), vocab / 32] int32, xgrammar's layout)."""
+
+    tokens: list[int]
+    rows: list[int] = field(default_factory=list)
+    bits: Any = None
+    cut: int = 0                                      # drafts dropped
+    ok: Any = None                                    # ``stage``: (allowed columns on the device, width, offset)
+    pinned: Any = None                                # the pinned host copy an asynchronous upload reads
+
+
+class Constraint:
+    """One reply's grammar at its chosen tokens (xgrammar's matcher): cuts verify windows, fills their rows' masks,
+    follows the chosen tokens."""
+
+    def __init__(self, matcher, vocab_size: int, *, think_end: int, active: bool, never=frozenset()) -> None:
+        self.m = matcher
+        self.never = never                            # tokens the grammar never takes (drafts of them: cut)
+        self.vocab = int(vocab_size)
+        self.words = (self.vocab + 31) // 32
+        self.think_end = int(think_end)
+        self.active = bool(active)
+        self.stats = {"windows": 0, "cut": 0, "rows": 0, "fill_ms": 0.0, "wait_ms": 0.0}
+
+    @property
+    def finished(self) -> bool:
+        """The grammar has taken its stop token: the reply is complete (anything after is not constrained)."""
+
+        return self.active and self.m.is_terminated()
+
+    def cut(self, tokens: Sequence[int]) -> Window:
+        """The rows an accepted path can use of a chain window (row 0 the pending token, already followed), and the
+        rows the grammar constrains. The matcher ends where it started."""
+
+        tokens = [int(t) for t in tokens]
+        try:
+            return self._cut(tokens)
+        except GrammarError:
+            raise
+        except Exception as exc:                      # noqa: BLE001  (xgrammar's failure ends this reply only)
+            raise GrammarError(f"the reply's grammar failed: {_message(exc)}") from None
+
+    def _cut(self, tokens: list[int]) -> Window:
+        self.stats["windows"] += 1
+        if self.finished:
+            return Window(tokens)
+        m = self.m
+        active = self.active
+        rows = [0] if active else []
+        keep, accepted = 1, 0
+        try:
+            for r in range(1, len(tokens)):
+                t = tokens[r]
+                if active:
+                    if t in self.never or not m.accept_token(t):    # the parent row's masked draw could never choose it
+                        break
+                    accepted += 1
+                    if m.is_terminated():                 # its stop token: nothing is verified after it
+                        break
+                else:
+                    active = t == self.think_end          # the grammar starts at the row after </think>
+                keep += 1
+                if active:
+                    rows.append(r)
+        finally:
+            if accepted:
+                m.rollback(accepted)
+        win = Window(tokens[:keep], rows, cut=len(tokens) - keep)
+        self.stats["cut"] += win.cut
+        self.stats["rows"] += len(rows)
+        return win
+
+    def fill(self, win: Window) -> Window:
+        """Each constrained row's allowed tokens (the kept path accepted row by row, then rolled back). Raises
+        GrammarError when a row allows no token at all."""
+
+        t0 = time.perf_counter()
+        try:
+            self._fill(win)
+        except GrammarError:
+            raise
+        except Exception as exc:                      # noqa: BLE001
+            raise GrammarError(f"the reply's grammar failed: {_message(exc)}") from None
+        finally:
+            self.stats["fill_ms"] += (time.perf_counter() - t0) * 1e3
+        return win
+
+    def _fill(self, win: Window) -> None:
+        if not win.rows:
+            win.bits = None
+            return
+        m = self.m
+        bits = np.empty((len(win.rows), self.words), dtype=np.int32)
+        active, accepted, j = self.active, 0, 0
+        try:
+            for r, t in enumerate(win.tokens):
+                if r:
+                    if active:
+                        if not m.accept_token(t):
+                            raise GrammarError(f"the reply's grammar rejected kept draft {t}")
+                        accepted += 1
+                    else:
+                        active = t == self.think_end
+                if active:
+                    if j >= len(win.rows) or win.rows[j] != r:
+                        raise GrammarError("a window's rows changed between its cut and its fill")
+                    m.fill_next_token_bitmask(bits, j)
+                    if not bits[j].any():
+                        raise GrammarError("the reply's grammar allows no token here")
+                    j += 1
+        finally:
+            if accepted:
+                m.rollback(accepted)
+        if j != len(win.rows):
+            raise GrammarError("a window's rows changed between its cut and its fill")
+        win.bits = bits
+
+    def advance(self, tokens: Sequence[int]) -> None:
+        """Follow chosen tokens (each chosen under this grammar's mask); after the stop token, nothing follows."""
+
+        try:
+            for t in tokens:
+                t = int(t)
+                if not self.active:
+                    self.active = t == self.think_end
+                    continue
+                if self.m.is_terminated():
+                    return
+                if not self.m.accept_token(t):
+                    raise GrammarError(f"the reply's grammar rejected chosen token {t}")
+        except GrammarError:
+            raise
+        except Exception as exc:                      # noqa: BLE001
+            raise GrammarError(f"the reply's grammar failed: {_message(exc)}") from None
+
+
+# -- masks on the logits ------------------------------------------------------------------------------------------
+_SHIFTS: dict[Any, Any] = {}
+
+
+def allowed(win: Window, width: int, device, offset: int = 0):
+    """The constrained rows' allowed columns [len(rows), width] (bool, on ``device``) for logits whose column 0 is
+    token ``offset`` (this rank's vocabulary half). Only the words covering those columns travel to the device; on a
+    GPU from pinned memory without a host wait (the copy is ordered after the forward on the stream)."""
+
+    import torch
+
+    device = torch.device(device)
+
+    words = win.bits.shape[1]
+    w0 = max(0, offset // 32)
+    w1 = min(words, -(-(offset + width) // 32))
+    n = len(win.rows)
+    if w1 <= w0:
+        return torch.zeros((n, width), dtype=torch.bool, device=device)
+    shifts = _SHIFTS.get(device)
+    if shifts is None:
+        shifts = _SHIFTS[device] = torch.arange(8, dtype=torch.uint8, device=device)
+    host = torch.from_numpy(np.ascontiguousarray(win.bits[:, w0:w1]))
+    if device.type == "cuda":
+        host = host.pin_memory()
+        win.pinned = host                             # alive until the copy has run
+        packed = host.to(device, non_blocking=True)
+    else:
+        packed = host.to(device)
+    packed = packed.view(torch.uint8)                 # token t: bit t % 8 of byte t // 8
+    bits = ((packed.unsqueeze(-1) >> shifts) & 1).view(n, -1)
+    s = offset - w0 * 32
+    got = bits[:, s:s + width].bool()
+    if got.shape[1] < width:                          # columns past the grammar's vocabulary: never allowed
+        got = torch.nn.functional.pad(got, (0, width - got.shape[1]), value=False)
+    return got
+
+
+def stage(win: Window | None, width: int, device, offset: int = 0) -> None:
+    """Right after the forward's launch (the fills done): the window's allowed columns queued on the device, so the
+    sampler's ``apply`` finds them there (the host never waits for the forward to upload them)."""
+
+    if win is not None and win.rows and win.bits is not None:
+        win.ok = (allowed(win, width, device, offset), int(width), int(offset))
+
+
+def apply(x, win: Window | None, offset: int = 0):
+    """``x`` (float logits rows [R, width], columns from token ``offset``) with each constrained row's disallowed
+    columns -inf: a new tensor (the forward's logits are not written). Rows the window does not constrain keep their
+    values."""
+
+    if win is None or not win.rows:
+        return x
+    import torch
+
+    staged = getattr(win, "ok", None)
+    if staged is not None and staged[1] == x.shape[-1] and staged[2] == offset and staged[0].device == x.device:
+        ok = staged[0]
+    else:
+        ok = allowed(win, x.shape[-1], x.device, offset)
+    if win.rows == list(range(x.shape[0])):
+        return x.masked_fill(~ok, float("-inf"))
+    out = x.clone()
+    idx = torch.tensor(win.rows, device=x.device)
+    out[idx] = out[idx].masked_fill(~ok, float("-inf"))
+    return out
+
+
+# -- fills while the forward runs ---------------------------------------------------------------------------------
+class Pending:
+    """Fills started for a round: ``wait`` -> per item None or the GrammarError it raised."""
+
+    def __init__(self, items, futures) -> None:
+        self.items, self.futures = items, futures
+
+    def wait(self) -> list[BaseException | None]:
+        out: list[BaseException | None] = []
+        for i, (con, win) in enumerate(self.items):
+            t0 = time.perf_counter()
+            try:
+                if self.futures is None:
+                    con.fill(win)
+                else:
+                    self.futures[i].result()
+            except GrammarError as exc:
+                out.append(exc)
+            else:
+                out.append(None)
+            con.stats["wait_ms"] += (time.perf_counter() - t0) * 1e3
+        return out
+
+
+class Filler:
+    """Mask fills for a round's constrained windows: on the worker node threads from ``start`` (right after the cut, before
+    the forward), or (``threads`` 0) on the calling thread in ``wait`` (after the forward's launch)."""
+
+    def __init__(self, n: int | None = None) -> None:
+        self.n = threads() if n is None else int(n)
+        self.pool = ThreadPoolExecutor(self.n, thread_name_prefix="glm-grammar") if self.n > 0 else None
+        if self.pool is not None:               # every worker made now, by the loading thread: they inherit its cpus
+            gate = threading.Barrier(self.n + 1)  # (patches/0370's ``rest``), not the round loop's single core
+            for _ in range(self.n):
+                self.pool.submit(gate.wait)
+            gate.wait()
+
+    def start(self, items: Sequence[tuple[Constraint, Window]]) -> Pending:
+        items = [(c, w) for c, w in items]
+        if self.pool is None:
+            return Pending(items, None)
+        return Pending(items, [self.pool.submit(c.fill, w) for c, w in items])
+
+
+# -- the engine's side ----------------------------------------------------------------------------------------------
+def vocab_size(model_dir: str | Path) -> int | None:
+    """The checkpoint's logits width from ``config.json`` (``text_config`` first), or None (upstream)."""
+
+    path = Path(model_dir) / "config.json"
+    if not path.is_file():
+        return None
+    config = json.loads(path.read_text())
+    for part in (config.get("text_config") or {}, config):
+        if isinstance(part.get("vocab_size"), int):
+            return int(part["vocab_size"])
+    return None
+
+
+def setup(g) -> None:
+    """At load (both ranks): the knob (both must agree), and with it on the compilers (so neither rank builds them
+    inside a round) and the fill threads. Sets ``g.grammar_on``, ``g.grammars`` (None: unavailable here, with
+    ``g.grammar_why``) and ``g.filler``."""
+
+    on = enabled()
+    both = g._gather_ints([int(on)])
+    if both[0] != both[1]:
+        raise RuntimeError(f"the two ranks were started with different {ENV}: rank 0 {both[0][0]}, rank 1 "
+                           f"{both[1][0]}")
+    g.grammar_on, g.grammars, g.grammar_why, g.filler = on, None, None, None
+    if not on:
+        return
+    t0 = time.perf_counter()
+    try:
+        vocab = vocab_size(g.model_dir)
+        if vocab is None:
+            raise ValueError("config.json has no vocab_size")
+        w = getattr(g, "w", None)
+        width = int(w.head.n) * (1 if w.comm is None else int(w.world)) if w is not None else vocab
+        if width != vocab:
+            raise ValueError(f"config.json's vocab_size {vocab} is not the logits' {width} columns")
+        g.grammars = Grammars.from_model(g.model_dir, vocab, tuple(g.eos))
+    except ImportError:
+        g.grammar_why = f"structured output needs xgrammar on the server ({EXTRA})"
+    except Exception as exc:  # noqa: BLE001 - reported, and the requests refused, on both ranks
+        g.grammar_why = f"structured output is unavailable: {type(exc).__name__}: {exc}"
+    ok = g._gather_ints([int(g.grammars is not None)])
+    if not (ok[0][0] and ok[1][0]):
+        why = g.grammar_why or "rank 1 could not build its grammar compiler"
+        g.grammars, g.grammar_why = None, why
+    else:
+        g.filler = Filler()
+    if g.rank == 0:
+        if g.grammars is None:
+            print(f"[tensorfold] structured output (patches/0610): {ENV}=1 but {g.grammar_why}; response_format and "
+                  "strict tools answer HTTP 400", flush=True)
+        else:
+            print(f"[tensorfold] structured output (patches/0610): response_format / guided_* / strict tool calls "
+                  f"enforced (xgrammar {getattr(g.grammars.xgr, '__version__', '?')}, {g.grammars.vocab_size} "
+                  f"columns, mask fills on {g.filler.n} thread(s) during the forward; built in "
+                  f"{time.perf_counter() - t0:.1f} s)", flush=True)
+
+
+def check(g, body: dict[str, Any]) -> str | None:
+    """Rank 0, before any header is sent: why the body's grammar cannot run (HTTP 400), compiling it (cached for the
+    request's run). Off: None (the fields are ignored as before)."""
+
+    if not getattr(g, "grammar_on", False):
+        return None
+    try:
+        spec = request_spec(body)
+        if spec is None:
+            return None
+        if getattr(g, "grammars", None) is None:
+            return getattr(g, "grammar_why", None) or "structured output is unavailable on this server"
+        g.grammars.compile(spec)
+    except ValueError as exc:
+        return str(exc)
+    return None
+
+
+def for_request(g, body: dict[str, Any]):
+    """Rank 0: (spec, compiled) for the calling thread's request (``g.request.grammar``), or None."""
+
+    if not getattr(g, "grammar_on", False) or getattr(g, "grammars", None) is None:
+        return None
+    spec = request_spec(body)
+    return None if spec is None else (spec, g.grammars.compile(spec))
+
+
+def bound_for(g, prompt: Sequence[int]) -> Bound | None:
+    """Rank 0, in ``generate``: the calling thread's grammar bound to its prompt (the think state), or None."""
+
+    req = getattr(getattr(g, "request", None), "grammar", None)
+    if req is None or not getattr(g, "grammar_on", False) or getattr(g, "grammars", None) is None:
+        return None
+    spec, compiled = req
+    return g.grammars.bind(spec, compiled, prompt)
+
+
+def follow(g, payload: Sequence[int]) -> Bound:
+    """Rank 1: a header's packed grammar, compiled here."""
+
+    if getattr(g, "grammars", None) is None:
+        raise RuntimeError("rank 0 sent a grammar, but this rank has no grammar compiler (GLM53_TF_GRAMMAR)")
+    return g.grammars.follow(payload)
+
+
+def fresh(g, bound: Bound | None) -> Constraint | None:
+    """A new reply's grammar state (each admission, so a background request that runs again starts over)."""
+
+    if bound is None:
+        return None
+    con = g.grammars.constraint(bound)
+    con.bound = bound
+    return con
+
+
+@contextmanager
+def first_token(e, con: Constraint | None):
+    """The prefill's first token under the reply's grammar (a one-row window): ``e.sample``'s target rows masked while
+    the prefill (or ``mpf``'s finish) runs, drafts never. Nothing changes without a constraint."""
+
+    if con is None:
+        yield
+        return
+    win = con.fill(con.cut([0]))
+    own = e.__dict__.get("sample")
+    inner = e.sample
+
+    def sample(logits, positions, sampling, *, draft: bool = False, probs=None):
+        if not draft and win.rows:
+            logits = apply(logits.float(), win, e.w.vocab_offset)
+            return _host_sample(e, inner, logits, positions, sampling, probs)
+        return inner(logits, positions, sampling, draft=draft, probs=probs)
+
+    e.sample = sample
+    try:
+        yield
+    finally:
+        if own is None:
+            e.__dict__.pop("sample", None)
+        else:
+            e.sample = own
+
+
+def _host_sample(e, inner, logits, positions, sampling, probs=None) -> list[int]:
+    """``Engine.sample`` of masked rows with the host's draw (patches/0450's device draw is not used for masked rows;
+    it is off in production). A stand-in engine's own ``sample`` is called as it is."""
+
+    from .decode import Engine, sample_rows
+
+    if getattr(inner, "__func__", None) is Engine.sample:
+        return sample_rows(e.w, logits, positions, sampling, None, probs, host=True)
+    return inner(logits, positions, sampling, draft=False, probs=probs)
+
+
+def sample(e, logits, positions, sampling, win: Window | None) -> list[int]:
+    """The lone loops' ``e.sample`` of a verify window's rows under the reply's grammar."""
+
+    if win is None or not win.rows:
+        return e.sample(logits, positions, sampling)
+    return _host_sample(e, e.sample, apply(logits.float(), win, e.w.vocab_offset), positions, sampling)
+
+
+class Lone:
+    """The lone engine's decode loops (``decode.serial_decode`` / ``mtp_decode`` / ``dflash_decode`` /
+    ``auto_decode``) under a reply's grammar: ``cut`` a window before the forward (fills start), ``sample`` its rows
+    masked, ``advance`` the chosen tokens (upstream 1da4b7e's hooks, with the fills off the critical path)."""
+
+    def __init__(self, e, con: Constraint) -> None:
+        self.e, self.con = e, con
+        self.filler = getattr(e, "grammar_filler", None) or Filler(0)
+        self.win: Window | None = None
+        self.pending: Pending | None = None
+        self.error: BaseException | None = None
+
+    def cut(self, tokens: Sequence[int]) -> list[int]:
+        self.win = self.con.cut(tokens)
+        self.pending = self.filler.start([(self.con, self.win)])
+        return list(self.win.tokens)
+
+    def forward(self, tokens: Sequence[int]):
+        """``e.forward`` of the cut window, then its masks (filled meanwhile; inline: now, while the GPU runs)."""
+
+        logits = self.e.forward(tokens)
+        self.settle(logits)
+        return logits
+
+    def settle(self, logits=None) -> None:
+        """The window's masks: waited for (worker threads), or filled now (inline) while the forward runs; then
+        staged on the logits' device."""
+
+        self.error = self.pending.wait()[0]
+        if self.error is None and logits is not None:
+            stage(self.win, logits.shape[-1], logits.device, self.e.w.vocab_offset)
+
+    def sample(self, logits, positions, sampling) -> list[int]:
+        if self.error is not None:
+            raise self.error
+        return sample(self.e, logits, positions, sampling, self.win)
+
+    def advance(self, tokens: Sequence[int]) -> None:
+        self.con.advance(tokens)
+
+
+def lone(e) -> Lone | None:
+    """``Lone`` for the engine's current reply, None without a grammar (the loops run as before)."""
+
+    con = getattr(e, "constraint", None)
+    return None if con is None else Lone(e, con)
+
+
+def report(con: Constraint | None) -> dict | None:
+    """The request's grammar stats (drafts cut, rows masked, fill / exposed wait ms)."""
+
+    if con is None:
+        return None
+    s = dict(con.stats)
+    s["fill_ms"], s["wait_ms"] = round(s["fill_ms"], 2), round(s["wait_ms"], 2)
+    s["finished"] = bool(con.finished)
+    return s
+
+
+__all__ = ["Bound", "Constraint", "ENV", "FIELDS", "Filler", "GrammarError", "Grammars", "KINDS", "Spec", "Window",
+           "allowed", "apply", "stage", "bound_for", "check", "enabled", "first_token", "follow", "for_request", "fresh",
+           "pack", "request_spec", "sample", "setup", "split", "think_active", "threads"]
